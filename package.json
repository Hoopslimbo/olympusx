{
  "author": "Hoopslimbo",
  "build": {
    "appId": "com.hoopslimbo.olympusx",
    "files": [
      "pc-app/main.js",
      "pc-app/preload.js",
      "pc-app/updater.js",
      "app/**/*",
      "assets/olympusx-logo.png"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "OlympusX",
      "artifactName": "OlympusX-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "OlympusX-Portable-0.1.0.exe"
    },
    "productName": "OlympusX",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    }
  },
  "description": "OlympusX game console for PC",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "main": "pc-app/main.js",
  "name": "olympusx",
  "productName": "OlympusX",
  "scripts": {
    "dist": "electron-builder --win"
  },
  "version": "0.1.1"
}
